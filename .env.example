# ═══════════════════════════════════════════════════════════════
#  Variables de entorno · Estudio Digital Pro
#  En local: copia este archivo como .env.local
#  En Vercel: Project → Settings → Environment Variables (y vuelve a desplegar)
# ═══════════════════════════════════════════════════════════════

# ── OBLIGATORIAS ─────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# «anon public» (o «publishable»). Es pública: puede ir al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# «service_role» (o «secret»). SECRETA: solo en el servidor, nunca en el código.
SUPABASE_SERVICE_ROLE_KEY=

# ── CORREO (recomendado) ─────────────────────────────────────
# Sin esto la web funciona, pero los formularios, reservas e incidencias solo se
# guardan en Supabase (no llegan al correo) y el cliente no recibe confirmación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@estudiodigitalpro.com
SMTP_PASS=
MAIL_TO=info@estudiodigitalpro.com

# ── OPCIONALES (estos son los valores por defecto) ───────────
# NEXT_PUBLIC_SITE_URL=https://estudiodigitalpro.com
# NEXT_PUBLIC_CONTACT_EMAIL=info@estudiodigitalpro.com
# NEXT_PUBLIC_CONTACT_PHONE=+34643168396
# MAIL_FROM="Estudio Digital Pro <info@estudiodigitalpro.com>"
# SMTP_SECURE=true
#
# Vídeo de /llamada: por defecto se sirve desde la propia web (public/video).
# NEXT_PUBLIC_VIDEO_URL=
# NEXT_PUBLIC_VIDEO_POSTER_URL=
#
# Agenda de llamadas
# BOOKING_TIMEZONE=Europe/Madrid
# BOOKING_SLOT_MINUTES=20
# BOOKING_HOURS="1-4=09:00-14:00,16:00-19:00;5=09:00-14:00"
# BOOKING_MIN_NOTICE_MINUTES=120
# BOOKING_HORIZON_DAYS=28
# BOOKING_CLOSED_DATES=
#
# Solo para `npm run setup` (crear tablas desde tu ordenador en vez de pegar el SQL):
# SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
