# ═══════════════════════════════════════════════════════════════
#  Variables de entorno · Estudio Digital Pro
#  En local: copia este archivo como .env
#  En Vercel: Project → Settings → Environment Variables (y vuelve a desplegar)
# ═══════════════════════════════════════════════════════════════

# ── FIREBASE (OBLIGATORIO) ──────────────────────────────────────
# Credenciales de Service Account de Firebase
FIREBASE_PROJECT_ID=edp-area-de-clientes
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@edp-area-de-clientes.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Clave pública de la app web de Firebase (en Project Settings → General → Web Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=edp-area-de-clientes
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=edp-area-de-clientes.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=edp-area-de-clientes.appspot.com

# ── CORREO (recomendado) ─────────────────────────────────────
# Sin esto la web funciona, pero los formularios, reservas e incidencias solo se
# guardan en Firestore (no llegan al correo) y el cliente no recibe confirmación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@estudiodigitalpro.com
SMTP_PASS=
MAIL_TO=info@estudiodigitalpro.com

# ── GOOGLE RECAPTCHA V3 (antispam transparente) ──────────────
# Obtén tus claves en https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── OPCIONALES (estos son los valores por defecto) ───────────
# NEXT_PUBLIC_SITE_URL=https://estudiodigitalpro.com
# NEXT_PUBLIC_CONTACT_EMAIL=info@estudiodigitalpro.com
# NEXT_PUBLIC_CONTACT_PHONE=+34643168396
# MAIL_FROM="Estudio Digital Pro <info@estudiodigitalpro.com>"
# SMTP_SECURE=true
#
# Vídeo de /llamada: por defecto se sirve desde la propia web (public/video).
# NEXT_PUBLIC_VIDEO_URL=
# NEXT_PUBLIC_VIDEO_POSTER_URL=
#
# Agenda de llamadas
# BOOKING_TIMEZONE=Europe/Madrid
# BOOKING_SLOT_MINUTES=20
# BOOKING_HOURS="1-4=09:00-14:00,16:00-19:00;5=09:00-14:00"
# BOOKING_MIN_NOTICE_MINUTES=120
# BOOKING_HORIZON_DAYS=28
# BOOKING_CLOSED_DATES=
